* text=auto
*.py text eol=lf
*.lean text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Preserve historical blobs byte for byte.
legacy/** -text
# External certified references are hashed as downloaded; never rewrite their bytes.
benchmarks/fixtures/longley-nist/** -text

# Reproducible laboratory artifacts carry byte hashes, including JSON and PDFs.
benchmarks/results/frontier-lab-951017/** -text -whitespace
benchmarks/results/frontier-lab-951017/**/*.pdf binary

# Historical transcript retained byte for byte, including original whitespace.
docs/history/DESCRIPTION_ORIGINAL.md -text -whitespace

# Source archives are generated; the complete archive preserves embedded bytes.
math.txt linguist-generated=true
NABLA.TXT -text -whitespace linguist-generated=true
lean/Conformance/*.lean linguist-generated=true
